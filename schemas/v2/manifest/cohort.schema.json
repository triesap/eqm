{
  "$defs": {
    "AuthoredExtensionValue": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/AuthoredExtensionValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/AuthoredExtensionValue"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "type": "object"
        }
      ]
    },
    "CohortAssignmentV2Dto": {
      "additionalProperties": false,
      "description": "One authored cohort assignment for an exact scenario occurrence.",
      "properties": {
        "artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "build_id": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x08\\x0b-\\x1f\\x7f-\\x9f]*$",
          "type": "string"
        },
        "occurrence": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "type": "string"
        },
        "provider_configuration_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "repository": {
          "maxLength": 1024,
          "pattern": "^https://[\\x20-\\x22\\x24-\\x2e\\x30-\\x3e\\x5b-\\x7e]+/[^\\x00-\\x20\\x7f?#@]*[^\\x00-\\x20\\x7f/?#@]$",
          "type": "string"
        },
        "source_commit": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "source_content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "target_configuration_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "occurrence",
        "repository",
        "source_commit"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/triesap/eqm/master/schemas/v2/manifest/cohort.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One strict v2 compatibility-cohort document.\n\nAssignments reuse the S038 exact-subject members and are keyed by unique\noccurrence. Target/provider configuration is graph-backed authority and is\nvalidated against the immutable projections; the authored source/build/\nartifact axes are independently supplied when matching candidate subjects.",
  "properties": {
    "assignments": {
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/CohortAssignmentV2Dto"
          },
          {
            "oneOf": [
              {
                "not": {
                  "required": [
                    "provider_configuration_digest"
                  ]
                },
                "required": [
                  "target_configuration_digest"
                ]
              },
              {
                "not": {
                  "required": [
                    "target_configuration_digest"
                  ]
                },
                "required": [
                  "provider_configuration_digest"
                ]
              }
            ]
          }
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/AuthoredExtensionValue"
      },
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,62}(?:\\.[a-z][a-z0-9_]{0,62}){2,}$"
      },
      "type": "object"
    },
    "id": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x08\\x0b-\\x1f\\x7f-\\x9f]*$",
      "type": "string"
    },
    "revision": {
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "scenario": {
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9_]{0,62}(?:\\.[a-z][a-z0-9_]{0,62})+$",
      "type": "string"
    },
    "schema": {
      "const": "https://raw.githubusercontent.com/triesap/eqm/master/schemas/v2/manifest/cohort.schema.json",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "id",
    "revision",
    "scenario",
    "assignments"
  ],
  "title": "CohortV2Dto",
  "type": "object"
}
