{
  "$defs": {
    "AuthoredExtensionValue": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/AuthoredExtensionValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/AuthoredExtensionValue"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://raw.githubusercontent.com/triesap/eqm/master/schemas/v2/manifest/provider.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One strict v2 provider authority document.\n\n`configuration_digest` is an external content reference declared by the\nauthor. It is distinct from the `eqm:v2:provider-configuration` identity the\ncanonical projection derives over this whole validated definition, and it\nproves neither acquisition nor trust of the referenced material.",
  "properties": {
    "configuration_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/AuthoredExtensionValue"
      },
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,62}(?:\\.[a-z][a-z0-9_]{0,62}){2,}$"
      },
      "type": "object"
    },
    "id": {
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9_]{0,62}(?:\\.[a-z][a-z0-9_]{0,62})+$",
      "type": "string"
    },
    "owners": {
      "items": {
        "pattern": "^owner://(?:team|role)/[a-z][a-z0-9_]{0,62}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "const": "https://raw.githubusercontent.com/triesap/eqm/master/schemas/v2/manifest/provider.schema.json",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "id",
    "configuration_digest",
    "owners"
  ],
  "title": "ProviderV2Dto",
  "type": "object"
}
