{
  "$id": "https://raw.githubusercontent.com/triesap/eqm/master/schemas/v2/manifest/provider.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One strict v2 provider authority document.\n\n`configuration_digest` is an external content reference declared by the\nauthor. It is distinct from the `eqm:v2:provider-configuration` identity the\ncanonical projection derives over this whole validated definition, and it\nproves neither acquisition nor trust of the referenced material.",
  "properties": {
    "configuration_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
      "type": "string"
    },
    "owners": {
      "items": {
        "pattern": "^owner://(?:team|role)/[a-z][a-z0-9_]{0,62}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "const": "https://raw.githubusercontent.com/triesap/eqm/master/schemas/v2/manifest/provider.schema.json",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "id",
    "configuration_digest",
    "owners"
  ],
  "title": "ProviderV2Dto",
  "type": "object"
}
