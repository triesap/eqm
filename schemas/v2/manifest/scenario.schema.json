{
  "$defs": {
    "AuthoredExtensionValue": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/AuthoredExtensionValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/AuthoredExtensionValue"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "type": "object"
        }
      ]
    },
    "ScenarioDependencyV2Dto": {
      "additionalProperties": false,
      "description": "One explicit directed occurrence dependency.",
      "properties": {
        "from": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "type": "string"
        },
        "to": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "ScenarioParticipantV2Dto": {
      "additionalProperties": false,
      "description": "One scenario participant occurrence.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "type": "string"
        },
        "role": {
          "maxLength": 255,
          "pattern": "^[a-z][a-z0-9_]{0,62}(?:\\.[a-z][a-z0-9_]{0,62})*$",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/ScenarioSubjectV2Dto"
        }
      },
      "required": [
        "id",
        "role",
        "subject"
      ],
      "type": "object"
    },
    "ScenarioSubjectV2Dto": {
      "additionalProperties": false,
      "description": "One tagged target/provider scenario subject. Exactly one tag must be present.",
      "oneOf": [
        {
          "not": {
            "required": [
              "provider"
            ]
          },
          "required": [
            "target"
          ]
        },
        {
          "not": {
            "required": [
              "target"
            ]
          },
          "required": [
            "provider"
          ]
        }
      ],
      "properties": {
        "provider": {
          "default": null,
          "maxLength": 255,
          "pattern": "^[a-z][a-z0-9_]{0,62}(?:\\.[a-z][a-z0-9_]{0,62})+$",
          "type": "string"
        },
        "target": {
          "default": null,
          "maxLength": 255,
          "pattern": "^[a-z][a-z0-9_]{0,62}(?:\\.[a-z][a-z0-9_]{0,62})*$",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/triesap/eqm/master/schemas/v2/manifest/scenario.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One strict v2 role-bearing scenario document.\n\nParticipants carry a unique occurrence ID, an explicit role and a tagged\ntarget/provider subject; dependencies are explicit directed occurrence\nreferences. Repeated target/provider references with different occurrence\nIDs remain distinct members. Provider references stay unresolved until their\nowning step supplies provider authority.",
  "properties": {
    "dependencies": {
      "items": {
        "$ref": "#/$defs/ScenarioDependencyV2Dto"
      },
      "type": "array"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/AuthoredExtensionValue"
      },
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,62}(?:\\.[a-z][a-z0-9_]{0,62}){2,}$"
      },
      "type": "object"
    },
    "id": {
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9_]{0,62}(?:\\.[a-z][a-z0-9_]{0,62})+$",
      "type": "string"
    },
    "participants": {
      "items": {
        "$ref": "#/$defs/ScenarioParticipantV2Dto"
      },
      "minItems": 1,
      "type": "array"
    },
    "revision": {
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "schema": {
      "const": "https://raw.githubusercontent.com/triesap/eqm/master/schemas/v2/manifest/scenario.schema.json",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "id",
    "revision",
    "participants"
  ],
  "title": "ScenarioV2Dto",
  "type": "object"
}
