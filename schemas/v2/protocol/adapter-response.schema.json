  "$id": "https://raw.githubusercontent.com/triesap/eqm/master/schemas/v2/protocol/adapter-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "type": "string"
    },
    "adapter_digest": {
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/DiagnosticV2Dto"
      },
      "type": "array"
    },
    "inventory": {
      "$ref": "#/$defs/InventoryV2Dto"
    },
    "request_id": {
      "type": "string"
    },
    "schema": {
      "const": "https://raw.githubusercontent.com/triesap/eqm/master/schemas/v2/protocol/adapter-response.schema.json",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AdapterStatusV2Dto"
    }
  },
  "required": [
    "schema",
    "request_id",
    "adapter",
    "adapter_digest",
    "status",
    "diagnostics"
  ],
  "title": "AdapterResponseV2Dto",
  "type": "object"
}
