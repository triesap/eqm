2][0-9]{10}|9223372030[0-9]{9}|922337203[1-5][0-9]{9}|92233720360[0-9]{8}|9223372036[1-7][0-9]{8}|922337203680[0-9]{7}|92233720368[1-4][0-9]{7}|9223372036850[0-9]{6}|922337203685[1-3][0-9]{6}|92233720368540[0-9]{5}|9223372036854[1-6][0-9]{5}|922337203685470[0-9]{4}|92233720368547[1-6][0-9]{4}|9223372036854770[0-9]{3}|922337203685477[1-4][0-9]{3}|92233720368547750[0-9]{2}|9223372036854775[1-7][0-9]{2}|9223372036854775800|922337203685477580[1-7]|9223372036854775808))$",
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "symbol",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "text",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "InventoryEntryV2Dto": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/FactValueV2Dto"
          },
          "type": "object"
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "key",
        "attributes",
        "source"
      ],
      "type": "object"
    },
    "InventoryV2Dto": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "type": "string"
        },
        "adapter_digest": {
          "type": "string"
        },
