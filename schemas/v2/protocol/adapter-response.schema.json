        "adapter_digest",
        "subject",
        "target",
        "generated_at",
        "completeness",
        "entries",
        "diagnostics",
        "inventory_digest"
      ],
      "type": "object"
    },
    "ScopeSubjectV2Dto": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "target",
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "provider",
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "target_set",
              "type": "string"
            },
            "targets": {
              "$ref": "#/$defs/CanonicalSet_string"
            }
          },
          "required": [
            "kind",
            "targets"
          ],
          "type": "object"
        }
      ]
    },
    "SeverityDto": {
      "description": "Closed diagnostic severity on the wire.",
      "oneOf": [
        {
          "const": "error",
          "description": "Blocking error.",
          "type": "string"
        },
        {
          "const": "warning",
          "description": "Non-blocking warning.",
          "type": "string"
        },
        {
          "const": "note",
          "description": "Informational note.",
          "type": "string"
        }
      ]
    },
    "SourceLocationV2Dto": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "$ref": "#/$defs/SourcePositionV2Dto"
        },
        "start": {
          "$ref": "#/$defs/SourcePositionV2Dto"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "uri",
        "start",
        "end"
      ],
      "type": "object"
    },
    "SourcePositionV2Dto": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "line",
        "column"
      ],
      "type": "object"
    }
