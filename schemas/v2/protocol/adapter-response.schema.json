{
  "$defs": {
    "AdapterStatusV2Dto": {
      "enum": [
        "ok",
        "partial",
        "error"
      ],
      "type": "string"
    },
    "CanonicalInstant": {
      "format": "date-time",
      "pattern": "^(000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{2}[1-9]|\\.[0-9][1-9][0-9]|\\.[1-9][0-9]{2}|\\.[0-9]{3}([0-9]{2}[1-9]|[0-9][1-9][0-9]|[1-9][0-9]{2})|\\.[0-9]{6}([0-9]{2}[1-9]|[0-9][1-9][0-9]|[1-9][0-9]{2}))?Z$",
      "type": "string"
    },
    "CanonicalSet_InventoryEntryV2Dto": {
      "items": {
        "$ref": "#/$defs/InventoryEntryV2Dto"
      },
      "type": "array",
      "uniqueItems": true
