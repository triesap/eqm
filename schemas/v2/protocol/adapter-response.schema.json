      "type": "array",
      "uniqueItems": true
    },
    "DiagnosticV2Dto": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "related": {
          "items": {
            "$ref": "#/$defs/SourceLocationV2Dto"
          },
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/SeverityDto"
        },
        "source": {
          "$ref": "#/$defs/SourceLocationV2Dto"
        },
        "target": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "related"
      ],
      "type": "object"
    },
    "EvidenceSubjectV2Dto": {
      "additionalProperties": false,
      "properties": {
        "artifact_digest": {
          "type": "string"
        },
        "build_id": {
          "type": "string"
