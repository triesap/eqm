          "$ref": "#/$defs/PolicySelectorDto"
        }
      },
      "required": [
        "selector",
        "minimum_level",
        "facets",
        "minimum_trust",
        "maximum_age"
      ],
      "type": "object"
    },
    "PolicySelectorDto": {
      "additionalProperties": false,
      "properties": {
        "facets": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "requirements": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "risk_classes": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "units": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "WaiverPolicyDto": {
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "maximum_days": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "minimum_approvers": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "required_controls": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
