{
  "$defs": {
    "PolicyRuleDto": {
      "additionalProperties": false,
      "properties": {
        "facets": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maximum_age": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "minimum_count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "minimum_level": {
          "type": "string"
        },
        "minimum_trust": {
          "type": "string"
        },
