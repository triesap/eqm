{
  "$defs": {
    "EvidenceSubjectDto": {
      "additionalProperties": false,
      "properties": {
        "artifact_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "build_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository": {
          "type": "string"
        },
        "repository_id_digest": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ScopeSubjectDto"
        },
        "source_commit": {
          "type": "string"
        },
        "target_configuration_digest": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "repository_id_digest",
        "scope",
        "source_commit",
        "target_configuration_digest"
      ],
      "type": "object"
    },
    "ProfileValueDto": {
      "additionalProperties": false,
      "description": "One selected profile dimension, sortable by profile then dimension.",
      "properties": {
        "dimension": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "profile",
        "revision",
        "dimension",
        "value"
      ],
      "type": "object"
    },
    "ScopeSubjectDto": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "target",
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "provider",
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "target_set",
              "type": "string"
            },
            "targets": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "targets"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://raw.githubusercontent.com/triesap/eqm/master/schemas/v1/protocol/attestation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "type": "string"
    },
    "conformance": {
      "type": "string"
    },
    "equivalence": {
      "type": "string"
    },
    "evaluated_at": {
      "type": "string"
    },
    "evaluation_subject": {
      "$ref": "#/$defs/EvidenceSubjectDto"
    },
    "evidence_digests": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "policy_digest": {
      "type": "string"
    },
    "profile_values": {
      "items": {
        "$ref": "#/$defs/ProfileValueDto"
      },
      "type": "array"
    },
    "release_record_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "release_status": {
      "type": "string"
    },
    "runtime_facts_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_version": {
      "type": "string"
    },
    "trust_config_digest": {
      "type": "string"
    },
    "waivers": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "workspace_digest": {
      "type": "string"
    }
  },
  "required": [
    "tool_version",
    "command",
    "workspace_digest",
    "policy_digest",
    "profile_values",
    "evaluation_subject",
    "evidence_digests",
    "trust_config_digest",
    "evaluated_at",
    "conformance",
    "equivalence",
    "release_status",
    "waivers"
  ],
  "title": "AttestationPredicateDto",
  "type": "object"
}
