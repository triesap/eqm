{
  "$defs": {
    "AttachmentDto": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "media_type",
        "digest",
        "size"
      ],
      "type": "object"
    },
    "AttemptDto": {
      "additionalProperties": false,
      "properties": {
        "finished_at": {
          "type": "string"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "outcome": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        }
      },
      "required": [
        "number",
        "outcome",
        "started_at",
        "finished_at"
      ],
      "type": "object"
    },
    "CountsDto": {
      "additionalProperties": false,
      "properties": {
        "failed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "filtered": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "quarantined": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "selected": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "skipped": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "selected",
        "passed",
        "failed",
        "skipped",
        "filtered",
        "quarantined"
      ],
      "type": "object"
    },
    "EvidenceSelectorDto": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "symbol",
              "type": "string"
            },
            "language": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "route",
              "type": "string"
            },
            "method": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "framework": {
              "type": "string"
            },
            "kind": {
              "const": "test",
              "type": "string"
            },
            "suite": {
              "type": [
                "string",
                "null"
              ]
            },
            "test_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "framework",
            "test_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "const": "inventory",
              "type": "string"
            },
            "record_type": {
              "type": "string"
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "record_type",
            "key"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "snapshot",
              "type": "string"
            },
            "snapshot_id": {
              "type": "string"
            },
            "variant": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "snapshot_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "channel": {
              "type": "string"
            },
            "kind": {
              "const": "release",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "channel"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://raw.githubusercontent.com/triesap/eqm/master/schemas/v1/protocol/test-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attachments": {
      "items": {
        "$ref": "#/$defs/AttachmentDto"
      },
      "type": "array",
      "uniqueItems": true
    },
    "attempts": {
      "items": {
        "$ref": "#/$defs/AttemptDto"
      },
      "type": "array"
    },
    "counts": {
      "$ref": "#/$defs/CountsDto"
    },
    "finished_at": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "selector": {
      "$ref": "#/$defs/EvidenceSelectorDto"
    },
    "started_at": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "selector",
    "attempts",
    "counts",
    "started_at",
    "finished_at",
    "attachments"
  ],
  "title": "TestResultDto",
  "type": "object"
}
